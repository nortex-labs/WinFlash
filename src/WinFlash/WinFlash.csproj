<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET Framework 4.8 выбран намеренно: он встроен в Windows 10/11 (ничего не нужно ставить),
    а в WinPE его даёт компонент WinPE-NetFx из ADK. Одна и та же программа работает в обоих местах.
    Внешних библиотек нет — exe остаётся маленьким и самодостаточным.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WinFlash</AssemblyName>
    <RootNamespace>WinFlash</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>WinFlash.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>0.2.0</Version>
    <Product>WinFlash</Product>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="WinFlash.ico" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
