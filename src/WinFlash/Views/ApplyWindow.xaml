<Window x:Class="WinFlash.Views.ApplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinFlash — настраиваем Windows"
        Width="760" Height="540" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="40,36,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image Source="/WinFlash.ico" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Настраиваем Windows" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="ProfileText" FontSize="13" Foreground="{StaticResource Subtle}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="HintText" Margin="0,22,0,0" FontSize="14" Foreground="{StaticResource Subtle}" TextWrapping="Wrap"
                   Text="Это займёт несколько минут. Можно не трогать компьютер: программы скачиваются и ставятся сами."/>

        <StackPanel Grid.Row="2" Margin="0,26,0,0">
            <DockPanel>
                <TextBlock x:Name="PercentText" DockPanel.Dock="Right" FontSize="14" Foreground="{StaticResource Subtle}"/>
                <TextBlock x:Name="StepText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Подготовка…"/>
            </DockPanel>
            <ProgressBar x:Name="Progress" Margin="0,12,0,0" Maximum="100"/>
        </StackPanel>

        <Border Grid.Row="3" Margin="0,22,0,0" Background="{StaticResource Sidebar}" CornerRadius="10"
                BorderBrush="{StaticResource Line}" BorderThickness="1">
            <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Consolas"
                     FontSize="12" Foreground="{StaticResource Subtle}" VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" Padding="12,10"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CloseButton" Content="Закрыть" Margin="0,0,10,0" Click="Close_Click" Visibility="Collapsed"/>
            <Button x:Name="RebootButton" Style="{StaticResource PrimaryButton}" Content="Перезагрузить сейчас" Click="Reboot_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
